{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberstrategyinstitute.com/schemas/ai-safe2/release-qualification-v1.schema.json",
  "title": "AI SAFE2 Developer Workflow Release Qualification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate", "required_capabilities", "evidence", "outcome", "missing_capabilities", "human_authority", "limitations"],
  "properties": {
    "schema_version": {"const": "ai-safe2.release-qualification.v1"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision"],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 100},
        "revision": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "required_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "status", "subject_revision", "producer", "evidence_ref", "limitations"],
        "properties": {
          "capability": {"type": "string", "minLength": 1, "maxLength": 100},
          "status": {"enum": ["not_requested", "unavailable", "failed", "produced"]},
          "subject_revision": {"type": "string", "minLength": 1, "maxLength": 200},
          "producer": {"type": "string", "minLength": 1, "maxLength": 200},
          "evidence_ref": {"type": ["string", "null"], "maxLength": 500},
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
        }
      }
    },
    "outcome": {"enum": ["hold", "ready_for_human_release_decision"]},
    "missing_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "human_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_decision_recorded", "release_owner", "release_at", "rationale"],
      "properties": {
        "release_decision_recorded": {"const": false},
        "release_owner": {"type": ["string", "null"], "maxLength": 200},
        "release_at": {"type": ["string", "null"], "format": "date-time"},
        "rationale": {"type": ["string", "null"], "maxLength": 2000}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  }
}
