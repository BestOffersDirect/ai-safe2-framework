{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberstrategyinstitute.com/schemas/ai-safe2/product-profile-v1.schema.json",
  "title": "AI SAFE2 Product Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "name", "maturity", "canary", "lenses", "critical_patterns", "enhanced_patterns", "required_human_roles_for_critical", "limitations"],
  "properties": {
    "schema_version": {"const": "ai-safe2.product-profile.v1"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "maturity": {"enum": ["preview", "qualified"]},
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_ref"],
      "properties": {
        "status": {"enum": ["not_run", "local_fixture", "external_repository"]},
        "evidence_ref": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "lenses": {"$ref": "#/$defs/strings"},
    "critical_patterns": {"$ref": "#/$defs/strings"},
    "enhanced_patterns": {"$ref": "#/$defs/strings"},
    "required_human_roles_for_critical": {"$ref": "#/$defs/strings"},
    "limitations": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  },
  "allOf": [
    {
      "if": {"properties": {"maturity": {"const": "qualified"}}},
      "then": {"properties": {"canary": {"properties": {"status": {"const": "external_repository"}, "evidence_ref": {"type": "string", "minLength": 1}}}}}
    },
    {
      "if": {"properties": {"canary": {"properties": {"status": {"enum": ["local_fixture", "external_repository"]}}}}},
      "then": {"properties": {"canary": {"properties": {"evidence_ref": {"type": "string", "minLength": 1}}}}}
    }
  ]
}
