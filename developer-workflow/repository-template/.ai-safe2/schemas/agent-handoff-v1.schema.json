{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberstrategyinstitute.com/schemas/ai-safe2/agent-handoff-v1.schema.json",
  "title": "AI SAFE2 Agent Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "boundary_id", "task_id", "base_revision", "result_revision", "executor_id", "status", "changed_paths", "skills_used", "evidence_refs", "findings", "assumptions", "unknowns", "conflicts", "residual_risks", "stop_conditions_triggered", "next_action", "authority", "limitations"],
  "properties": {
    "schema_version": {"const": "ai-safe2.agent-handoff.v1"},
    "handoff_id": {"$ref": "#/$defs/id"},
    "boundary_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "base_revision": {"$ref": "#/$defs/id"},
    "result_revision": {"$ref": "#/$defs/id"},
    "executor_id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["completed", "partial", "blocked", "failed"]},
    "changed_paths": {"$ref": "#/$defs/paths"},
    "skills_used": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "evidence_refs": {"$ref": "#/$defs/paths"},
    "findings": {"$ref": "#/$defs/texts"},
    "assumptions": {"$ref": "#/$defs/texts"},
    "unknowns": {"$ref": "#/$defs/texts"},
    "conflicts": {"$ref": "#/$defs/texts"},
    "residual_risks": {"$ref": "#/$defs/texts"},
    "stop_conditions_triggered": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "next_action": {"type": "string", "minLength": 1, "maxLength": 2000},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completion_verified", "merge", "release", "deploy", "risk_acceptance"],
      "properties": {
        "completion_verified": {"const": false},
        "merge": {"const": false},
        "release": {"const": false},
        "deploy": {"const": false},
        "risk_acceptance": {"const": false}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "paths": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "texts": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 4000}}
  }
}
