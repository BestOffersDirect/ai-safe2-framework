{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberstrategyinstitute.com/schemas/ai-safe2/review-provenance-v1.schema.json",
  "title": "AI SAFE2 Review Provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_evidence_id", "subject", "producer", "inputs", "relationship_to_change_author", "dependence_assessment", "limitations"],
  "properties": {
    "schema_version": {"const": "ai-safe2.review-provenance.v1"},
    "review_evidence_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "revision", "scope"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1, "maxLength": 200},
        "revision": {"type": "string", "minLength": 1, "maxLength": 200},
        "scope": {"type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "adapter_id", "provider", "model_family", "operator_id"],
      "properties": {
        "kind": {"enum": ["human", "model", "deterministic_tool", "hybrid"]},
        "adapter_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "provider": {"type": ["string", "null"], "maxLength": 200},
        "model_family": {"type": ["string", "null"], "maxLength": 200},
        "operator_id": {"type": ["string", "null"], "maxLength": 200}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_refs", "prior_review_evidence_ids", "implementation_evidence_ids"],
      "properties": {
        "context_refs": {"$ref": "#/$defs/strings"},
        "prior_review_evidence_ids": {"$ref": "#/$defs/strings"},
        "implementation_evidence_ids": {"$ref": "#/$defs/strings"}
      }
    },
    "relationship_to_change_author": {"enum": ["same_actor", "different_actor", "mixed", "unknown"]},
    "dependence_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "known_overlaps", "assessor", "basis"],
      "properties": {
        "status": {"enum": ["not_assessed", "correlated", "separation_observed"]},
        "known_overlaps": {"type": "array", "uniqueItems": true, "items": {"enum": ["provider", "model_family", "prompt", "context", "evidence", "operator", "organization", "unknown"]}},
        "assessor": {"type": ["string", "null"], "maxLength": 200},
        "basis": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
  },
  "allOf": [
    {
      "if": {"properties": {"producer": {"properties": {"kind": {"const": "human"}}}}},
      "then": {"properties": {"producer": {"properties": {"operator_id": {"type": "string", "minLength": 1}}}}}
    },
    {
      "if": {"properties": {"dependence_assessment": {"properties": {"status": {"const": "separation_observed"}}}}},
      "then": {"properties": {"dependence_assessment": {"properties": {"known_overlaps": {"maxItems": 0}, "assessor": {"type": "string", "minLength": 1}}}}}
    },
    {
      "if": {"properties": {"dependence_assessment": {"properties": {"status": {"const": "correlated"}}}}},
      "then": {"properties": {"dependence_assessment": {"properties": {"known_overlaps": {"minItems": 1}}}}}
    }
  ],
  "$defs": {
    "strings": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  }
}
