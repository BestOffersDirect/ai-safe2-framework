{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberstrategyinstitute.com/schemas/ai-safe2/adversarial-assurance-receipt-v1.schema.json",
  "title": "AI SAFE2 Adversarial Assurance Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "subject", "required_methods", "campaigns", "conclusion", "authority", "limitations"],
  "properties": {
    "schema_version": {"const": "ai-safe2.adversarial-assurance-receipt.v1"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "revision", "scope"],
      "properties": {
        "identifier": {"$ref": "#/$defs/id"},
        "revision": {"$ref": "#/$defs/id"},
        "scope": {"$ref": "#/$defs/strings_nonempty"}
      }
    },
    "required_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/method"}},
    "campaigns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/campaign"}
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "satisfied_methods", "methods_with_findings", "incomplete_methods"],
      "properties": {
        "status": {"enum": ["pass", "findings", "incomplete"]},
        "satisfied_methods": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/method"}},
        "methods_with_findings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/method"}},
        "incomplete_methods": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/method"}}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completion_verified", "merge", "release", "risk_acceptance"],
      "properties": {
        "completion_verified": {"const": false},
        "merge": {"const": false},
        "release": {"const": false},
        "risk_acceptance": {"const": false}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "strings": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "strings_nonempty": {"type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "method": {"enum": ["property", "mutation", "fuzz"]},
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "method", "target", "tool", "execution_status", "started_at", "completed_at", "counts", "finding_refs", "artifact_refs", "failure_reason", "limitations"],
      "properties": {
        "campaign_id": {"$ref": "#/$defs/id"},
        "method": {"$ref": "#/$defs/method"},
        "target": {"$ref": "#/$defs/text"},
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 200},
            "version": {"type": "string", "minLength": 1, "maxLength": 200}
          }
        },
        "execution_status": {"enum": ["not_requested", "unavailable", "failed", "produced"]},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempted", "completed", "findings", "skipped", "timed_out"],
          "properties": {
            "attempted": {"type": "integer", "minimum": 0},
            "completed": {"type": "integer", "minimum": 0},
            "findings": {"type": "integer", "minimum": 0},
            "skipped": {"type": "integer", "minimum": 0},
            "timed_out": {"type": "integer", "minimum": 0}
          }
        },
        "finding_refs": {"$ref": "#/$defs/strings"},
        "artifact_refs": {"$ref": "#/$defs/strings"},
        "failure_reason": {"type": ["string", "null"], "maxLength": 2000},
        "limitations": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/text"}}
      },
      "allOf": [
        {
          "if": {"properties": {"execution_status": {"const": "produced"}}},
          "then": {"properties": {"started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"}, "artifact_refs": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"execution_status": {"enum": ["unavailable", "failed"]}}},
          "then": {"properties": {"failure_reason": {"type": "string", "minLength": 1}}}
        }
      ]
    }
  }
}
