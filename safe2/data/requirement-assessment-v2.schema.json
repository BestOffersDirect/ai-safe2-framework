{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberstrategyinstitute.com/schemas/requirement-assessment-v2",
  "title": "Revision-bound clause evidence record",
  "description": "Framework record contract only. Schema validity does not authenticate observations, check complete applicability, establish conformance or grant authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework_version",
    "requirements_revision",
    "system_id",
    "system_revision",
    "scope",
    "assessed_at",
    "assessment_owner",
    "required_clause_ids",
    "clauses",
    "authorization_granted"
  ],
  "properties": {
    "schema_version": {
      "const": "safe2.requirement-assessment.v2"
    },
    "framework_version": {
      "const": "3.5.0"
    },
    "requirements_revision": {
      "type": "string",
      "minLength": 1
    },
    "system_id": {
      "type": "string",
      "minLength": 1
    },
    "system_revision": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "assessment_owner": {
      "type": "string",
      "minLength": 1
    },
    "required_clause_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clause_id",
          "applicability",
          "applicability_basis",
          "result",
          "evidence_refs",
          "evidence_origin",
          "collector_scope",
          "observed_at"
        ],
        "properties": {
          "clause_id": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {
            "enum": [
              "applicable",
              "not_applicable",
              "unknown"
            ]
          },
          "applicability_basis": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "untested",
              "not_applicable"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_origin": {
            "enum": [
              "declared",
              "independent-claim-unverified",
              "verified-external-observation",
              "unknown"
            ]
          },
          "collector_scope": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "pass"
                }
              },
              "required": [
                "result"
              ]
            },
            "then": {
              "properties": {
                "applicability": {
                  "const": "applicable"
                },
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "applicability": {
                  "const": "not_applicable"
                }
              },
              "required": [
                "applicability"
              ]
            },
            "then": {
              "properties": {
                "result": {
                  "const": "not_applicable"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "result": {
                  "const": "not_applicable"
                }
              },
              "required": [
                "result"
              ]
            },
            "then": {
              "properties": {
                "applicability": {
                  "const": "not_applicable"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "applicability": {
                  "const": "unknown"
                }
              },
              "required": [
                "applicability"
              ]
            },
            "then": {
              "properties": {
                "result": {
                  "enum": [
                    "unknown",
                    "untested"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "authorization_granted": {
      "const": false
    }
  }
}
